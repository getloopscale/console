#
# OPERATOR LOCAL-REBUILD Dockerfile — uses local contracts via go.mod replace
# (the canonical local-dev path per loop-console/CLAUDE.md § Invariants: "contracts
# is consumed via `replace => ../contracts` today (local)") so the GHCR rebuild
# does NOT depend on the sponsor-managed gomod_token PAT.
#
# Build context: /home/paulo/loop-console (META-DIR), so both `loop-console/` and
# `contracts/` are in the BuildKit context.
#
# Usage (operator):
#   cd /home/paulo/loop-console
#   docker buildx build --platform linux/amd64 \
#     -f loop-console/Dockerfile.local \
#     -t ghcr.io/getloopscale/loop-console:develop \
#     -t ghcr.io/getloopscale/loop-console:release-blockers-<sha> \
#     --push .
#
# This file is SIBLING of the canonical Dockerfile (which fetches contracts from
# GitHub via gomod_token). The canonical Dockerfile remains the source of truth for
# CI / GHCR canonical builds; this file is the OPERATOR escape hatch for local-replace
# rebuilds when the token is unavailable. Per CLAUDE.md "Local equals production":
# both files produce the SAME distroless image with the SAME CGO_ENABLED=0 static
# binary — the only difference is HOW contracts is resolved during go mod download.

FROM golang:1.26.10-alpine3.23@sha256:78e7f1e419545bc4b8b5ee8a40a99ddb5df1216d38681dbab2eeb1fdb2427f43 AS builder
WORKDIR /workspace

ENV GOWORK=off
# GOPRIVATE intentionally unset — local replace avoids the private-module fetch path.

# git is still required (some transitive deps may VCS-resolve).
RUN apk add --no-cache git

# Stage contracts INTO the build context so the local replace points at a
# concrete path INSIDE the container, not at a host-relative ../ path that
# the BuildKit chroot cannot resolve.
COPY contracts/ /contracts/

# Stage loop-console go.mod + go.sum and inject the local replace at build time.
# The replace target is the in-container path /contracts (NOT a relative path
# — relative paths cannot escape the BuildKit chroot).
COPY loop-console/go.mod loop-console/go.sum ./
RUN echo "" >> go.mod && \
    echo "replace github.com/getloopscale/contracts => /contracts" >> go.mod

# Download deps WITHOUT a gomod_token mount — the replace resolves contracts
# locally, and every OTHER dep is public.
RUN --mount=type=cache,target=/root/go/pkg/mod \
    go mod download

COPY loop-console/cmd/ ./cmd/
COPY loop-console/internal/ ./internal/
COPY loop-console/openapi/ ./openapi/

RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /cloud-api ./cmd

# Distroless static runtime — byte-identical posture vs. canonical Dockerfile.
FROM gcr.io/distroless/static-debian12:nonroot

LABEL org.opencontainers.image.source="https://github.com/getloopscale/loop-console"
LABEL org.opencontainers.image.title="loop-console"
LABEL org.opencontainers.image.description="LoopConsole service (operator local-replace build)"

COPY --from=builder /cloud-api /cloud-api
USER nonroot:nonroot
EXPOSE 13002

CMD ["/cloud-api"]

# Go
/bin/
*.test
*.out
coverage*.lcov

# Dashboard (Node/Vite)
dashboard/node_modules/
dashboard/dist/
node_modules/

# Local / editor
*.local
.DS_Store
dashboard/test-results/

# Cycle kit (.claude/) — Python bytecode + tool caches + runtime artifacts
.claude/**/__pycache__/
.claude/**/*.pyc
.claude/**/.pytest_cache/
.claude/**/.ruff_cache/
.claude/**/.mypy_cache/
.claude/.compaction-snapshots/
.claude/knowledge-base/implementations/.progress-*.json
.claude/knowledge-base/references/

# Playwright test reports (build output)
dashboard/playwright-report/
sdk/storage-ts/.npmrc
**/.npmrc
sdk/storage-ts/node_modules
sdk/storage-ts/dist
sdk/storage-ts/package-lock.json

# Saida de ferramenta de auditoria (loop-devops-audit): .db + relatorios gerados.
# Evidencia de uma execucao, nao codigo — vive no knowledge-base quando vira decisao.
devops-audit-output/

# Plugin patch backups — local recovery snapshots, never part of the history.
.claude/.patch-backups/

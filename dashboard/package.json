{
  "name": "@theo/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "bundle:analyze": "ANALYZE=true vite build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "tree-shake-check": "npm run build && node scripts/check-mocks-tree-shaken.mjs",
    "test:e2e": "playwright test"
  },
  "size-limit": [
    {
      "name": "01 — react-vendor (React 19 runtime) [eager]",
      "path": "dist/assets/react-vendor-*.js",
      "limit": "55 KB"
    },
    {
      "name": "02 — router (react-router-dom) [eager]",
      "path": "dist/assets/router-*.js",
      "limit": "15 KB"
    },
    {
      "name": "03 — app entry [eager]",
      "path": "dist/assets/entry-*.js",
      "limit": "25 kB"
    },
    {
      "name": "04 — vendor (node_modules eager, pos B-021/B-073)",
      "path": "dist/assets/vendor-*.js",
      "limit": "230 kB"
    },
    {
      "name": "05 — per-route chunk (worst-case, lazy)",
      "path": "dist/assets/register-*.js",
      "limit": "10 KB"
    },
    {
      "name": "TOTAL EAGER — HARD GATE (os 4 chunks com modulepreload no index.html, brotli)",
      "path": [
        "dist/assets/entry-*.js",
        "dist/assets/react-vendor-*.js",
        "dist/assets/router-*.js",
        "dist/assets/vendor-*.js"
      ],
      "limit": "320 kB"
    }
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@theokit/ui": "^1.3.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/canvas-confetti": "^1.9.0",
    "@usetheo/ui": "^0.35.1",
    "ansi-to-html": "^0.7.2",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.460.0",
    "nuqs": "^2.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^4.1.2",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.0.0",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.8.10",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-app": "^12.1.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "size-limit": "^12.1.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2",
    "workbox-window": "^7.4.1"
  }
}

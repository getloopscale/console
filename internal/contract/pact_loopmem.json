{
  "_comment": "T2.5 of plan canonical-tests-rewrite-v2 v1.0 per ADR-2026-06-17-T3 D7 + ADR-V2-D2 (pending sponsor sign-off for broker).",
  "consumer": {
    "name": "loop-console"
  },
  "provider": {
    "name": "loopscale-data-loopmem"
  },
  "interactions": [
    {
      "description": "GET /loopmem/v1/memory/{tenant_id} returns tenant memory snapshot",
      "providerState": "tenant has saved memory entries",
      "request": {
        "method": "GET",
        "path": "/loopmem/v1/memory/{tenant_id}",
        "headers": {
          "X-Service-Auth": "ed25519-signed-payload"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "tenant_id": "uuid-v4",
          "entries": "array",
          "version": "integer"
        }
      }
    },
    {
      "description": "POST /loopmem/v1/memory/{tenant_id}/entries appends entry",
      "providerState": "tenant exists; entry under per-tenant size cap",
      "request": {
        "method": "POST",
        "path": "/loopmem/v1/memory/{tenant_id}/entries",
        "headers": {
          "X-Service-Auth": "ed25519-signed-payload",
          "Idempotency-Key": "uuid-v4"
        },
        "body": {
          "kind": "string",
          "content": "string",
          "ttl_seconds": "integer-or-null"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "uuid-v4",
          "created_at": "ISO-8601"
        }
      }
    },
    {
      "description": "DELETE /loopmem/v1/memory/{tenant_id}/entries/{id} removes entry",
      "providerState": "entry exists",
      "request": {
        "method": "DELETE",
        "path": "/loopmem/v1/memory/{tenant_id}/entries/{id}",
        "headers": {
          "X-Service-Auth": "ed25519-signed-payload"
        }
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "GET /loopmem/v1/health returns 200",
      "providerState": "service is up",
      "request": {
        "method": "GET",
        "path": "/loopmem/v1/health"
      },
      "response": {
        "status": 200
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "2.0.0"
    }
  }
}
